---
/**
 * FontSetup.astro
 *
 * 使用 Astro Font API（<Font /> 组件）统一管理字体加载。
 * 字体定义在 fontConfig.ts 的 fonts 数组中配置，
 * 本组件负责渲染 <Font /> 标签并设置 body 字体和区域覆盖 CSS 变量。
 *
 * 字体的 fallback 由各字体定义中的 fallbacks 字段控制（Astro Font API 处理），
 */
import { Font } from "astro:assets";
import { fontConfig, fontsList } from "@/config";
import { collectUsedFontCssVars } from "@/utils/fontHelper";

// 使用共享的工具函数收集所有需要加载的 CSS 变量名（selected + 各区域字体，去重）
// enable=false 时返回空集，不会加载任何字体
const allCssVars = fontConfig.enable
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

// cssVariable → 字体定义 的映射，用于区分「Astro Font API 字体」与「CDN 字体」
const fontByCssVar = new Map(fontsList.map((f) => [f.cssVariable, f]));

// 拆分两类字体：
// - astroCssVars：由 Astro Font API 管理，渲染 <Font />（自动下载、缓存、生成 @font-face）
// - cdnFonts：自带 CDN 子集化（unicode-range + font-display: swap）的字体，
//   直接输出 <link rel="stylesheet"> + CSS 变量，浏览器只下载实际用到的字体分片
const astroCssVars: string[] = [];
const cdnFonts: Array<{
	cssVariable: string;
	name: string;
	urls: string[];
	fallbacks: string[];
}> = [];
for (const v of allCssVars) {
	const f = fontByCssVar.get(v);
	if (f?.cdnUrl) {
		cdnFonts.push({
			cssVariable: v,
			name: f.name,
			urls: Array.isArray(f.cdnUrl) ? f.cdnUrl : [f.cdnUrl],
			fallbacks: f.fallbacks ?? ["sans-serif"],
		});
	} else {
		astroCssVars.push(v);
	}
}

// 所有 CDN 字体样式表 URL（扁平化，用于逐个输出 <link>）
const cdnUrls: string[] = cdnFonts.flatMap((f) => f.urls);

// 去重后的 CDN 源（用于 preconnect，提前完成 DNS + TCP/TLS 握手，省掉首字节前的 RTT）
const cdnOrigins = [
	...new Set(
		cdnUrls
			.map((u) => {
				try {
					return new URL(u).origin;
				} catch {
					return null;
				}
			})
			.filter((o): o is string => !!o),
	),
];

// 统一解析 selected 为数组（用于后续 body font-family 和 preload 判断）
const selectedIds: string[] =
	fontConfig.enable && fontConfig.selected
		? Array.isArray(fontConfig.selected)
			? fontConfig.selected
			: [fontConfig.selected]
		: [];

// 生成 body 的 font-family 值
// 每个字体的 fallback 由其在 fonts 中的 fallbacks 字段控制
// 这里只拼接 CSS 变量引用，末尾加系统字体作为最终保底
const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
// 代码字体的系统保底栈，codeFont 没配置或字体加载失败时用它，保证行内代码/代码块始终是等宽字体
const MONO_FONT_STACK =
	'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace';
const selectedFontVars = selectedIds.filter((v) => v !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((v) => `var(${v})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;

// 各区域字体 CSS 变量值
const bannerTitleFontVar = fontConfig.enable
	? fontConfig.bannerTitleFont || ""
	: "";
const bannerSubtitleFontVar = fontConfig.enable
	? fontConfig.bannerSubtitleFont || ""
	: "";
const navbarTitleFontVar = fontConfig.enable
	? fontConfig.navbarTitleFont || ""
	: "";
const codeFontVar = fontConfig.enable ? fontConfig.codeFont || "" : "";
// --font-code 由 fontConfig.codeFont 决定，行内代码和代码块统一引用它
// 末尾始终带 MONO_FONT_STACK 保底，避免 codeFont 为空时 var() 解析失败导致字体回退到正文字体
const codeFontFamily = codeFontVar
	? `var(${codeFontVar}, ${MONO_FONT_STACK})`
	: MONO_FONT_STACK;
// CDN 字体定义的 CSS 变量（形如：--font-lxgw-wenkai: "LXGW WenKai", sans-serif;）
const cdnVarDeclarations = cdnFonts
	.map((f) => `${f.cssVariable}: "${f.name}", ${f.fallbacks.join(", ")};`)
	.join("\n    ");

// 首屏字体：正文 selected 字体 + banner/导航栏区域字体都在首屏可见（LCP 相关），
// 全部 preload，让字体文件与页面 HTML 并行下载，避免 swap 前的回退字体闪烁
const lcpFontVars = new Set(
	[
		...selectedFontVars,
		bannerTitleFontVar,
		bannerSubtitleFontVar,
		navbarTitleFontVar,
	].filter((v): v is string => !!v),
);
---

<!-- Astro Font API: 自动下载、缓存并生成优化的 @font-face -->
{astroCssVars.map((cssVar) => (
  <Font
    cssVariable={cssVar as any}
    preload={lcpFontVars.has(cssVar)}
  />
))}

<!-- CDN 字体：preconnect 源站（含 crossorigin 双池，兼容不同加载模式）+
     高优先级 preload 第一份 CSS，与 HTML 解析并行，显著降低首屏字体等待 -->
{cdnOrigins.map((origin) => (
  <>
    <link rel="preconnect" href={origin} />
    <link rel="preconnect" href={origin} crossorigin />
  </>
))}
{cdnUrls.length > 0 && (
  <link rel="preload" href={cdnUrls[0]} as="style" fetchpriority="high" />
)}

<!-- CDN 字体样式表：自带 unicode-range 子集化 + font-display: swap，
     浏览器只下载页面实际用到的字体分片，不经过 Astro Font API -->
{cdnUrls.map((url) => (
  <link rel="stylesheet" href={url} />
))}

<!-- 区域字体 CSS 变量 + body 字体 -->
<!-- --font-code 无条件输出，即使关闭自定义字体，行内代码和代码块也要保持等宽字体 -->
<style
  set:html={`
  :root {
    --font-code: ${codeFontFamily};
    ${cdnVarDeclarations}
    ${bannerTitleFontVar ? `--font-banner-title: var(${bannerTitleFontVar}, inherit);` : ""}
    ${bannerSubtitleFontVar ? `--font-banner-subtitle: var(${bannerSubtitleFontVar}, inherit);` : ""}
    ${navbarTitleFontVar ? `--font-navbar-title: var(${navbarTitleFontVar}, inherit);` : ""}
  }

  ${
		fontConfig.enable &&
		(bannerTitleFontVar ||
			bannerSubtitleFontVar ||
			navbarTitleFontVar ||
			selectedFontVars.length > 0)
			? `body {
      font-family: ${bodyFontFamily};
    }`
			: ""
	}
`}
/>

<script>
  // 字体加载完成事件
  if (document.fonts && typeof document.fonts.ready !== "undefined") {
    document.fonts.ready
      .then(() => {
        document.dispatchEvent(new CustomEvent("fontsLoaded"));
      })
      .catch((error) => {
        console.warn("Font loading failed:", error);
      });
  }
</script>
